# ===== Arrival Ready 本地环境样例 =====
# 复制为 .env 后按需修改；.env 绝不入库（.gitignore 已覆盖）。
# 本文件不含任何真实密钥（docs/03 §4.3）。

# ---- Go API（services/api）----
PORT=8080
ENV=dev
# 本地 compose 的 PostgreSQL；缺省时 API 可启动但 /readyz 返回 503 并说明原因
DATABASE_URL=postgres://arrival:arrival_dev@localhost:5432/arrivalready?sslmode=disable
# AI 服务内网地址（B07 audit job 接线时硬性必填）
AI_SERVICE_URL=http://localhost:8100

# ---- OIDC 身份（B05）----
# 真实 IdP 接入后填写；三者为空且未开启测试身份时受保护路由 503（fail closed）
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# ---- 本地测试身份（仅 dev；真实数据路径禁止使用，B05）----
# 双开关：ENV=dev 且 =1 才生效；密钥 >= 32 字节。生产环境缺失 OIDC 时不会回退到此身份。
ARRIVAL_ENABLE_TEST_IDENTITY=
ARRIVAL_TEST_IDENTITY_SECRET=

# ---- AI Service（services/ai）----
PORT_AI=8100
# 模型供应商凭据随 B08 落地（D-007 未确认前留空；留空时 /readyz 明确报告未配置）
MODEL_API_KEY=
MODEL_BASE_URL=

# ---- 本地基础设施（docker-compose.yml，仅开发凭据）----
POSTGRES_USER=arrival
POSTGRES_PASSWORD=arrival_dev
POSTGRES_DB=arrivalready
MINIO_ROOT_USER=arrival
MINIO_ROOT_PASSWORD=arrival_dev_password
